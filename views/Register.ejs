<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Register || Drivio</title>
    <link rel="shortcut icon" href="../images/icon.png" type="image/x-icon">
    <link rel="stylesheet" href="../css/Register.css">
</head>
<body>

    <main>
        <form action="/register" method="POST">

            <div class="right">
                <h3>Drivio.</h3>

                <div class="hero">
                    <h2>Your Digital Storage Journey Starts Here</h2>
                    <p>Store, manage and access your files anytime, anywhere.</p>
                </div>

                <span class="bottom-text">Your files. Your space. Your control.</span>
            </div>

            <div class="left">

                <div class="form-heading">
                    <h1>Create Account</h1>
                    <p>Enter your details to get started.</p>
                </div>

                <div class="input-group">
                    <label>Username (must be unique)</label>
                    <input type="text" name="username" placeholder="Choose a unique username" required>
                </div>

                <div class="input-group">
                    <label>Email Address</label>
                    <input type="email" name="email" placeholder="Enter your email" required>
                </div>

                <div class="input-group">
                    <label>Password</label>
                    <input type="password" name="password" placeholder="Create a password" required>
                </div>


                <button type="submit">Create Account</button>

                <p class="login-text">
                    Already have an account?
                    <a href="/login">Sign In</a>
                </p>

            </div>

        </form>
    </main>

</body>
</html>